<section class="rounded-lg border-2 border-zinc-950 bg-white p-5 shadow-[5px_5px_0_#18181b]">
	<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
		<div>
			<h2 class="text-lg font-black">Saved Notes</h2>
			<p class="mt-1 text-sm text-zinc-600">Search and review your notes.</p>
		</div>
		<form id="search-form" class="flex gap-2">
			<input name="question" placeholder="Search" class="min-w-0 rounded-md border border-zinc-300 px-3 py-2 text-sm outline-none focus:border-yellow-500 focus:ring-2 focus:ring-yellow-200" />
			<button class="rounded-md bg-yellow-300 px-3 py-2 text-sm font-black hover:bg-yellow-400">Search</button>
		</form>
	</div>

	<div class="mt-4 flex gap-2">
		<button id="refresh-notes" class="rounded-md border border-zinc-950 px-3 py-2 text-sm font-bold hover:bg-yellow-100">
			Refresh
		</button>
		<button id="clear-search" class="rounded-md border border-zinc-950 px-3 py-2 text-sm font-bold hover:bg-yellow-100">
			Clear
		</button>
	</div>

	<div id="notes-list" class="mt-5 grid gap-3"></div>
</section>
