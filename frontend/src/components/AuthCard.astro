---
const { mode } = Astro.props;
const isRegister = mode === "register";
---

<section class="rounded-lg border-2 border-zinc-950 bg-white p-5 shadow-[6px_6px_0_#18181b]">
	<form id={isRegister ? "register-form" : "login-form"} class="grid gap-4">
		<div>
			<h2 class="text-xl font-black text-zinc-950">{isRegister ? "Create account" : "Welcome back"}</h2>
			<p class="mt-1 text-sm text-zinc-600">
				{isRegister ? "Make an account before saving notes." : "Log in to open your notes dashboard."}
			</p>
		</div>

		<label class="grid gap-1 text-sm font-semibold">
			<span>Email</span>
			<input
				name="email"
				type="email"
				required
				class="rounded-md border border-zinc-300 px-3 py-2 font-normal outline-none focus:border-yellow-500 focus:ring-2 focus:ring-yellow-200"
			/>
		</label>

		<label class="grid gap-1 text-sm font-semibold">
			<span>Password</span>
			<input
				name="password"
				type="password"
				required
				minlength={isRegister ? "8" : undefined}
				class="rounded-md border border-zinc-300 px-3 py-2 font-normal outline-none focus:border-yellow-500 focus:ring-2 focus:ring-yellow-200"
			/>
		</label>

		<button class="rounded-md bg-zinc-950 px-4 py-2.5 text-sm font-black text-yellow-50 hover:bg-zinc-800">
			{isRegister ? "Register" : "Login"}
		</button>
	</form>

	<p class="mt-4 text-sm text-zinc-600">
		{
			isRegister
				? "Already have an account?"
				: "Need an account?"
		}
		<a href={isRegister ? "/login" : "/register"} class="font-bold text-zinc-950 underline">
			{isRegister ? "Login" : "Register"}
		</a>
	</p>
</section>
