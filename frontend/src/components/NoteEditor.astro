<section class="rounded-lg border-2 border-zinc-950 bg-white p-5 shadow-[5px_5px_0_#18181b]">
	<h2 class="text-lg font-black">New Note</h2>

	<form id="note-form" class="mt-4 grid gap-3">
		<label class="grid gap-1 text-sm font-semibold">
			<span>Question</span>
			<input name="question" required minlength="2" maxlength="200" class="rounded-md border border-zinc-300 px-3 py-2 font-normal outline-none focus:border-yellow-500 focus:ring-2 focus:ring-yellow-200" />
		</label>

		<div class="grid gap-3 sm:grid-cols-2">
			<label class="grid gap-1 text-sm font-semibold">
				<span>Category</span>
				<select id="note-category" name="category_id" required class="rounded-md border border-zinc-300 px-3 py-2 font-normal outline-none focus:border-yellow-500 focus:ring-2 focus:ring-yellow-200">
					<option value="">Choose category</option>
				</select>
			</label>
			<label class="grid gap-1 text-sm font-semibold">
				<span>Pattern</span>
				<input name="pattern" required minlength="2" maxlength="100" class="rounded-md border border-zinc-300 px-3 py-2 font-normal outline-none focus:border-yellow-500 focus:ring-2 focus:ring-yellow-200" />
			</label>
		</div>

		<label class="grid gap-1 text-sm font-semibold">
			<span>Key question</span>
			<input name="key_question" required minlength="2" class="rounded-md border border-zinc-300 px-3 py-2 font-normal outline-none focus:border-yellow-500 focus:ring-2 focus:ring-yellow-200" />
		</label>

		<label class="grid gap-1 text-sm font-semibold">
			<span>Signal</span>
			<textarea name="signal" required minlength="2" rows="2" class="rounded-md border border-zinc-300 px-3 py-2 font-normal outline-none focus:border-yellow-500 focus:ring-2 focus:ring-yellow-200"></textarea>
		</label>

		<label class="grid gap-1 text-sm font-semibold">
			<span>Brute force</span>
			<textarea name="brute_force" required minlength="2" rows="2" class="rounded-md border border-zinc-300 px-3 py-2 font-normal outline-none focus:border-yellow-500 focus:ring-2 focus:ring-yellow-200"></textarea>
		</label>

		<label class="grid gap-1 text-sm font-semibold">
			<span>Useful memory</span>
			<textarea name="useful_memory" required minlength="2" rows="2" class="rounded-md border border-zinc-300 px-3 py-2 font-normal outline-none focus:border-yellow-500 focus:ring-2 focus:ring-yellow-200"></textarea>
		</label>

		<label class="grid gap-1 text-sm font-semibold">
			<span>Solution approach</span>
			<textarea name="solution_approach" required minlength="2" rows="3" class="rounded-md border border-zinc-300 px-3 py-2 font-normal outline-none focus:border-yellow-500 focus:ring-2 focus:ring-yellow-200"></textarea>
		</label>

		<div class="grid gap-3 sm:grid-cols-2">
			<label class="grid gap-1 text-sm font-semibold">
				<span>Time</span>
				<input name="time_complexity" required minlength="1" maxlength="50" placeholder="O(n)" class="rounded-md border border-zinc-300 px-3 py-2 font-normal outline-none focus:border-yellow-500 focus:ring-2 focus:ring-yellow-200" />
			</label>
			<label class="grid gap-1 text-sm font-semibold">
				<span>Space</span>
				<input name="space_complexity" required minlength="1" maxlength="50" placeholder="O(1)" class="rounded-md border border-zinc-300 px-3 py-2 font-normal outline-none focus:border-yellow-500 focus:ring-2 focus:ring-yellow-200" />
			</label>
		</div>

		<button class="rounded-md bg-zinc-950 px-4 py-2.5 text-sm font-black text-yellow-50 hover:bg-zinc-800">
			Save note
		</button>
	</form>
</section>
