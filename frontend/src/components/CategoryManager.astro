<section class="rounded-lg border-2 border-zinc-950 bg-white p-5 shadow-[5px_5px_0_#18181b]">
	<div class="flex items-center justify-between gap-4">
		<div>
			<h2 class="text-lg font-black">Categories</h2>
			<p class="mt-1 text-sm text-zinc-600">Create pattern groups.</p>
		</div>
		<button id="refresh-categories" class="rounded-md border border-zinc-950 px-3 py-2 text-sm font-bold hover:bg-yellow-100">
			Refresh
		</button>
	</div>

	<form id="category-form" class="mt-4 grid gap-3">
		<label class="grid gap-1 text-sm font-semibold">
			<span>Name</span>
			<input name="name" required minlength="2" maxlength="50" class="rounded-md border border-zinc-300 px-3 py-2 font-normal outline-none focus:border-yellow-500 focus:ring-2 focus:ring-yellow-200" />
		</label>
		<button class="rounded-md bg-yellow-300 px-4 py-2 text-sm font-black text-zinc-950 hover:bg-yellow-400">
			Add category
		</button>
	</form>

	<div id="category-list" class="mt-4 flex flex-wrap gap-2"></div>
</section>
